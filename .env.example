DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require"
# Non-pooled connection, used only by the Prisma CLI (migrate/generate) — pooled
# connections (e.g. Neon's PgBouncer endpoint) don't reliably support the
# advisory lock `migrate deploy` needs. Runtime queries still use DATABASE_URL.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
SESSION_SECRET="generate with: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
